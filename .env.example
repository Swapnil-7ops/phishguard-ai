# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DATABASE=phishguard
# Legacy aliases (optional)
MONGO_URI=mongodb://localhost:27017/
DATABASE_NAME=phishguard

# LLM Configuration (OPTIONAL - system works without any LLM configured)
LLM_PROVIDER=gemini
OPENAI_API_KEY=
GEMINI_API_KEY=

# Flask Web Server Configuration
FLASK_SECRET_KEY=phishguard-secure-secret-key-pbl-2026
FLASK_ENV=development
DEBUG=True
PORT=5000

# File Upload Configuration (MB)
MAX_UPLOAD_SIZE_MB=10

# Privacy Settings: Set to false to avoid storing raw message content in MongoDB
STORE_RAW_CONTENT=true

# Model Version
MODEL_VERSION=1.0.0

# Threat Intelligence Configuration (OPTIONAL - system works without any TI configured)
VIRUSTOTAL_API_KEY=
THREAT_INTEL_TIMEOUT_SEC=5.0
THREAT_INTEL_CACHE_TTL_SEC=3600
